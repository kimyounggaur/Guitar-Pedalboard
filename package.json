{
  "name": "guitar-pedalboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test:chorus": "node scripts/chorus-regression.mjs",
    "test:flanger": "node scripts/flanger-regression.mjs",
    "test:phaser": "node scripts/phaser-regression.mjs",
    "test:tremolo": "node scripts/tremolo-regression.mjs",
    "test:tap-tempo": "node scripts/tap-tempo-regression.mjs",
    "test:preset-ab": "node scripts/preset-ab-regression.mjs",
    "test:shortcuts": "node scripts/shortcuts-regression.mjs",
    "test:midi": "node scripts/midi-regression.mjs",
    "test:recording": "node scripts/recording-regression.mjs",
    "test:responsive-a11y": "node scripts/responsive-a11y-regression.mjs",
    "test:pwa": "node scripts/pwa-regression.mjs",
    "test:auto-wah": "node scripts/auto-wah-regression.mjs",
    "test:graphic-eq": "node scripts/graphic-eq-regression.mjs",
