{
  "name": "guitar-pedalboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test:chorus": "node scripts/chorus-regression.mjs",
    "test:flanger": "node scripts/flanger-regression.mjs",
    "test:phaser": "node scripts/phaser-regression.mjs",
    "test:tremolo": "node scripts/tremolo-regression.mjs",
    "test:tap-tempo": "node scripts/tap-tempo-regression.mjs",
    "test:preset-ab": "node scripts/preset-ab-regression.mjs",
    "test:shortcuts": "node scripts/shortcuts-regression.mjs",
    "test:midi": "node scripts/midi-regression.mjs",
    "test:recording": "node scripts/recording-regression.mjs",
    "test:responsive-a11y": "node scripts/responsive-a11y-regression.mjs",
    "test:pwa": "node scripts/pwa-regression.mjs",
    "test:auto-wah": "node scripts/auto-wah-regression.mjs",
    "test:graphic-eq": "node scripts/graphic-eq-regression.mjs",
    "test:tuner": "node scripts/tuner-regression.mjs",
    "preview": "vite preview",
    "test:dsp-safety": "node scripts/dsp-safety-regression.mjs",
    "test:howl": "node scripts/howl-guard-regression.mjs",
    "test": "npm run test:chorus && npm run test:flanger && npm run test:phaser && npm run test:tremolo && npm run test:tap-tempo && npm run test:preset-ab && npm run test:shortcuts && npm run test:midi && npm run test:recording && npm run test:pwa && npm run test:auto-wah && npm run test:graphic-eq && npm run test:tuner && npm run test:dsp-safety && npm run test:howl && npm run test:compressor-phase && npm run test:output-device && npm run test:history && npm run test:cabinet-ir && npm run test:knob && npm run test:latency && npm run test:peak-limiter && npm run test:cabinet-response",
    "test:compressor-phase": "node scripts/compressor-phase-regression.mjs",
    "test:output-device": "node scripts/output-device-regression.mjs",
    "test:history": "node scripts/history-regression.mjs",
    "test:cabinet-ir": "node scripts/cabinet-ir-regression.mjs",
    "test:knob": "node scripts/knob-regression.mjs",
    "test:latency": "node scripts/latency-regression.mjs",
    "test:peak-limiter": "node scripts/peak-limiter-regression.mjs",
    "test:cabinet-response": "node scripts/cabinet-response-analysis.mjs"
